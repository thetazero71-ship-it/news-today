# Prevent PHP execution in the uploads directory.
# Apache 2.4 syntax first, with a guarded 2.2 fallback: a bare "Order" line
# on a 2.4-only host turns every upload into a 500 error.
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>
